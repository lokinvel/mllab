function sendMessage() {
    let input = document.getElementById("message");
    let chatBox = document.getElementById("chatBox");

    let userMessage = input.value.trim();

    if (userMessage === "") return;

    // User message
    let user = document.createElement("div");
    user.className = "user-message";
    user.innerText = "You: " + userMessage;
    chatBox.appendChild(user);

    input.value = "";

    // Bot reply
    let botReply = getBotReply(userMessage);

    setTimeout(() => {
        let bot = document.createElement("div");
        bot.className = "bot-message";
        bot.innerText = "Bot: " + botReply;
        chatBox.appendChild(bot);

        chatBox.scrollTop = chatBox.scrollHeight;
    }, 500);
}

function getBotReply(message) {
    message = message.toLowerCase();

    if (message === "hi" || message === "hello") {
        return "Hello! How can I help you?";
    }
    else if (message === "how are you") {
        return "I'm doing great! Thanks for asking.";
    }
    else if (message === "what is your name") {
        return "I'm a 55chatbot.";
    }
    else if (message === "bye") {
        return "Goodbye! Have a nice day.";
    }
    else {
        return "Sorry, I don't understand your message.";
    }
}

document.getElementById("message").addEventListener("keypress", function(e) {
    if (e.key === "Enter") {
        sendMessage();
    }
});


