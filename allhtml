<script>
$(document).ready(function () {
 $("#password").keyup(function () {
 let password = $(this).val();
 let score = 0;
 if (password.length >= 8) {
 score++;
 }
 if (/[a-z]/.test(password) &&
 /[A-Z]/.test(password)) {
 score++;
 }
 if (/[0-9]/.test(password)) {
 score++;
 }
 if (/[^A-Za-z0-9]/.test(password)) {
 score++;
 }
 if (password.length === 0) {
 $("#strength")
 .text("Enter a password")
 .removeClass()
 .attr("id", "strength");
 }
 else if (score <= 1) {
 $("#strength")
 .text("Weak Password")
 .removeClass() .addClass("weak");
 }
 else if (score <= 3) {
 $("#strength")
 .text("Medium Password")
 .removeClass()
 .addClass("medium");
 }
 else {
 $("#strength")
 .text("Strong Password")
 .removeClass()
 .addClass("strong");
 }
 });
